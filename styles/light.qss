/* Светлая тема оформления IS-OTK-ELMA */

/* Основной фон окон — светлый для всех виджетов */
QMainWindow#MainWindow, QMainWindow, QDialog, QWidget {
    background-color: #f5f5f5;
}

/* Явный фон для центральных контейнеров MainWindow */
QWidget#centralWidget {
    background-color: #f5f5f5;
}
QWidget#widget {
    background-color: #f5f5f5;
}
QFrame#contentFrame {
    background-color: #F4F7FB;
}

/* Шрифт по умолчанию */
QWidget {
    color: #000000;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Заголовки и надписи — прозрачный фон, чтобы не перекрывать дизайн */
QLabel {
    background: transparent;
}

QLabel#lblCurrentOrders {
    color: #17365D;
}

/* Фреймы — прозрачный фон, чтобы не перекрывать инлайн-стили из .ui файлов */
QFrame {
    background: transparent;
}

/* Кнопки */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1c5980;
}

/* Поля ввода */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    padding: 6px;
    border-radius: 4px;
    color: #000000;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3498db;
}

/* Таблицы */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #e0e0e0;
    border: 1px solid #cccccc;
}

QTableWidget::item {
    background: transparent;
    color: #000000;
    padding: 4px;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #000000;
    padding: 6px;
    border: 1px solid #cccccc;
    font-weight: bold;
}

/* Боковая панель */
QFrame#sidebar {
    background-color: #2c3e50;
}

QFrame#sidebar QPushButton {
    background-color: transparent;
    text-align: left;
    padding: 12px 20px;
    border-radius: 0;
    color: #ecf0f1;
}

QFrame#sidebar QPushButton:hover {
    background-color: #34495e;
}

QFrame#sidebar QPushButton:checked {
    background-color: #3498db;
    color: #ffffff;
    font-weight: bold;
}

/* Карточки статистики и контейнеры */
QFrame#cardOrders,
QFrame#cardActiveOrders,
QFrame#cardClients,
QFrame#cardPendingChecks,
QFrame#cardTotalOrders,
QFrame#cardOrdersInProgress,
QFrame#cardOrdersPending,
QFrame#cardOrdersCompleted,
QFrame#cardTotalClients,
QFrame#cardActiveClients,
QFrame#cardClientsWithOrders,
QFrame#statsCard,
QFrame#statsCard2,
QFrame#statsCard3,
QFrame#profileCard {
    background-color: #ffffff;
    border: 1px solid #DCE5EF;
    border-radius: 10px;
}

/* Заголовки и надписи — прозрачный фон, чтобы не перекрывать дизайн */
QLabel {
    background: transparent;
}

QLabel#lblSidebarLogo {
    color: #FFFFFF;
    background-color: #245A91;
}

/* Окно выбора типа входа */
QDialog#ChooseLoginDialog {
    background-color: #F4F7FA;
}

QDialog#ChooseLoginDialog QFrame#headerFrame {
    background-color: #173B60;
    border-radius: 14px;
}

QDialog#ChooseLoginDialog QLabel#lblLogo,
QDialog#ChooseLoginDialog QLabel#lblWelcome {
    color: white;
    font-weight: bold;
    background: transparent;
}

QDialog#ChooseLoginDialog QLabel#lblSystemName,
QDialog#ChooseLoginDialog QLabel#lblSubtitle {
    color: #D7E7F6;
    background: transparent;
}

QDialog#ChooseLoginDialog QFrame#employeeCard,
QDialog#ChooseLoginDialog QFrame#clientCard {
    background-color: #ffffff;
    border: 1px solid #DCE4EC;
    border-radius: 12px;
}

QDialog#ChooseLoginDialog QFrame#employeeCard:hover,
QDialog#ChooseLoginDialog QFrame#clientCard:hover {
    background-color: #F3F8FC;
    border: 1px solid #245A91;
}

QDialog#ChooseLoginDialog QLabel#lblEmployeeIcon,
QDialog#ChooseLoginDialog QLabel#lblClientIcon {
    background: transparent;
    min-width: 48px;
    min-height: 48px;
}

QDialog#ChooseLoginDialog QLabel#lblEmployeeTitle,
QDialog#ChooseLoginDialog QLabel#lblClientTitle {
    color: #173B60;
    background: transparent;
    font-size: 16px;
    font-weight: 700;
}

QDialog#ChooseLoginDialog QLabel#lblEmployeeDescription,
QDialog#ChooseLoginDialog QLabel#lblClientDescription {
    color: #5C6B7A;
    background: transparent;
    font-size: 12px;
}

QDialog#ChooseLoginDialog QPushButton#btnEmployeeLogin,
QDialog#ChooseLoginDialog QPushButton#btnClientLogin {
    background-color: #245A91;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 11px 8px;
    font-weight: bold;
    font-size: 13px;
}

QDialog#ChooseLoginDialog QPushButton#btnEmployeeLogin:hover,
QDialog#ChooseLoginDialog QPushButton#btnClientLogin:hover {
    background-color: #1B466F;
}

QDialog#ChooseLoginDialog QLabel#lblFooter {
    color: rgb(162, 162, 162);
    background: transparent;
}

/* Чекбоксы */
QCheckBox {
    background: transparent;
    color: #000000;
    spacing: 7px;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    padding: 4px 8px;
    border-radius: 4px;
    color: #000000;
}

QComboBox:focus {
    border: 1px solid #3498db;
}

/* Групповые рамки и separators */
QFrame {
    background: transparent;
    border: none;
}

QFrame[frameShape="4"] { /* HLine */
    background-color: #e0e0e0;
    border: none;
    max-height: 1px;
    min-height: 1px;
}
