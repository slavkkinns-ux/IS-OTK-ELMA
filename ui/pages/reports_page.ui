<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Ui_ReportsPage</class>
 <widget class="QWidget" name="pageReports">
  <property name="styleSheet">
   <string notr="true">QWidget#pageReports {
    background-color: #F1F3F6;
    color: #24364B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
    color: #24364B;
}

QLabel#lblReportsTitle {
    color: #183B63;
    font-size: 24pt;
    font-weight: bold;
}

QLabel#lblReportsSubtitle {
    color: #60758E;
    font-size: 10pt;
}

QFrame#headerFrameReports,
QFrame#filtersFrameReports,
QFrame#actionsFrameReports {
    background-color: transparent;
    border: none;
}

QFrame#statsFrameReports {
    background-color: transparent;
    border: none;
}

QFrame#cardTotalReports,
QFrame#cardReportsThisMonth,
QFrame#cardReportsPending {
    background-color: #FFFFFF;
    border: 1px solid #D8E3EF;
    border-radius: 10px;
}

QFrame#cardTotalReports QLabel,
QFrame#cardReportsThisMonth QLabel,
QFrame#cardReportsPending QLabel {
    background-color: transparent;
    border: none;
}

QLabel#lblTotalReportsTitle,
QLabel#lblReportsThisMonthTitle,
QLabel#lblReportsPendingTitle {
    color: #60758E;
    font-size: 9pt;
}

QLabel#lblTotalReportsValue,
QLabel#lblReportsThisMonthValue,
QLabel#lblReportsPendingValue {
    color: #174A7E;
    font-size: 23pt;
    font-weight: bold;
}

QComboBox#comboreportsOrder {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 8px 10px;
}

QComboBox#comboreportsOrder:hover {
    border: 1px solid #2D83D5;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #24364B;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
    border: 1px solid #D8E3EF;
}

QTableWidget#tableReportResearch {
    background-color: #FFFFFF;
    alternate-background-color: #F6F9FC;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E4EAF1;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
}

QTableWidget#tableReportResearch::item {
    padding: 7px;
}

QTableWidget#tableReportResearch::item:selected {
    background-color: #DCEBFA;
    color: #183B63;
}

QTextBrowser#reportPreviewBrowser {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    padding: 10px;
}

QTableWidget#tableRecentReports {
    background-color: #FFFFFF;
    alternate-background-color: #F6F9FC;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E4EAF1;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
}

QTableWidget#tableRecentReports::item {
    padding: 7px;
}

QTableWidget#tableRecentReports::item:selected {
    background-color: #DCEBFA;
    color: #183B63;
}

QHeaderView::section {
    background-color: #E8EFF7;
    color: #244B73;
    border: none;
    border-bottom: 1px solid #D2DFEC;
    padding: 9px 7px;
    font-weight: bold;
}

QPushButton {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton:disabled {
    background-color: #B9C7D5;
    color: #F4F6F8;
    border: 1px solid #B9C7D5;
}

QPushButton#btnAddReport {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
}

QPushButton#btnAddReport:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton#btnViewReport,
QPushButton#btnExportReport {
    background-color: #E4EBF3;
    color: #294D70;
    border: 1px solid #D0DCE8;
}

QPushButton#btnViewReport:hover,
QPushButton#btnExportReport:hover {
    background-color: #D5E3F1;
    color: #294D70;
    border: 1px solid #C2D5E8;
}

QScrollBar:vertical {
    background-color: #EDF1F5;
    width: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #B7C7D8;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8FA9C3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #EDF1F5;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #B7C7D8;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}</string>
