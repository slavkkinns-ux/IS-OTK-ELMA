<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Ui_OrdersPage</class>
 <widget class="QWidget" name="pageOrders">
  <property name="styleSheet">
   <string notr="true">QWidget#pageOrders {
    background-color: #F1F3F6;
    color: #24364B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
    color: #24364B;
}

QLabel#lblOrdersTitle_2 {
    color: #183B63;
    font-size: 24pt;
    font-weight: bold;
}

QLabel#lblOrdersSubtitle {
    color: #60758E;
    font-size: 10pt;
}

QFrame#headerFrameOrders,
QFrame#filtersFrameOrders,
QFrame#actionsFrameOrders {
    background-color: transparent;
    border: none;
}

QFrame#statsFrameOrders {
    background-color: transparent;
    border: none;
}

QFrame#cardTotalOrders,
QFrame#cardOrdersInProgress,
QFrame#cardOrdersPending,
QFrame#cardOrdersCompleted {
    background-color: #FFFFFF;
    border: 1px solid #D8E3EF;
    border-radius: 10px;
}

QFrame#cardTotalOrders QLabel,
QFrame#cardOrdersInProgress QLabel,
QFrame#cardOrdersPending QLabel,
QFrame#cardOrdersCompleted QLabel {
    background-color: transparent;
    border: none;
}

QLabel#lblTotalOrdersTitle,
QLabel#lblOrdersInProgressTitle,
QLabel#lblOrdersPendingTitle,
QLabel#lblOrdersCompletedTitle {
    color: #60758E;
    font-size: 9pt;
}

QLabel#lblTotalOrdersValue,
QLabel#lblOrdersInProgressValue,
QLabel#lblOrdersPendingValue,
QLabel#lblOrdersCompletedValue {
    color: #174A7E;
    font-size: 23pt;
    font-weight: bold;
}

QLineEdit#editOrderSearch {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 9px 11px;
    selection-background-color: #2D83D5;
}

QLineEdit#editOrderSearch:focus {
    border: 1px solid #2D83D5;
}

QComboBox#comboOrderStatus {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 8px 10px;
}

QComboBox#comboOrderStatus:hover {
    border: 1px solid #2D83D5;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #24364B;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
    border: 1px solid #D8E3EF;
}

QDateEdit#dateFrom, QDateEdit#dateTo {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 8px 10px;
}

QDateEdit#dateFrom:focus, QDateEdit#dateTo:focus {
    border: 1px solid #2D83D5;
}

QPushButton {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton:disabled {
    background-color: #B9C7D5;
    color: #F4F6F8;
    border: 1px solid #B9C7D5;
}

QPushButton#btnSearchOrders,
QPushButton#btnAddOrder,
QPushButton#btnEditOrder {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
}

QPushButton#btnSearchOrders:hover,
QPushButton#btnAddOrder:hover,
QPushButton#btnEditOrder:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton#btnSearchOrders:pressed,
QPushButton#btnAddOrder:pressed,
QPushButton#btnEditOrder:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton#btnResetOrderFilters,
QPushButton#btnViewOrder,
QPushButton#btnRefreshOrder {
    background-color: #E4EBF3;
    color: #294D70;
    border: 1px solid #D0DCE8;
}

QPushButton#btnResetOrderFilters:hover,
QPushButton#btnViewOrder:hover,
QPushButton#btnRefreshOrder:hover {
    background-color: #D5E3F1;
    color: #294D70;
    border: 1px solid #C2D5E8;
}

QPushButton#btnResetOrderFilters:pressed,
QPushButton#btnViewOrder:pressed,
QPushButton#btnRefreshOrder:pressed {
    background-color: #C6D8EA;
    color: #294D70;
    border: 1px solid #B5CADD;
}

QPushButton#btnServices {
    background-color: #244B73;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton#btnServices:hover {
    background-color: #174A7E;
}

QTableWidget#tableOrders {
    background-color: #FFFFFF;
    alternate-background-color: #F6F9FC;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E4EAF1;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
}

QTableWidget#tableOrders::item {
    padding: 7px;
}

QTableWidget#tableOrders::item:selected {
    background-color: #DCEBFA;
    color: #183B63;
}

QHeaderView::section {
    background-color: #E8EFF7;
    color: #244B73;
    border: none;
    border-bottom: 1px solid #D2DFEC;
    padding: 9px 7px;
    font-weight: bold;
}

QScrollBar:vertical {
    background-color: #EDF1F5;
    width: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #B7C7D8;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8FA9C3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #EDF1F5;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #B7C7D8;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}</string>
