<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Ui_EmployeesPage</class>
 <widget class="QWidget" name="pageEmployees">
  <property name="styleSheet">
   <string notr="true">QWidget#pageEmployees {
    background-color: #F1F3F6;
    color: #24364B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
    color: #24364B;
}

QLabel#lblEmployeesTitle {
    color: #183B63;
    font-size: 24pt;
    font-weight: bold;
}

QLabel#lblEmployeesSubtitle {
    color: #60758E;
    font-size: 10pt;
}

QFrame#headerFrameEmployees,
QFrame#filtersFrameEmployees,
QFrame#actionsFrameEmployees {
    background-color: transparent;
    border: none;
}

QFrame#statsFrameEmployees {
    background-color: transparent;
    border: none;
}

QFrame#cardTotalEmployees,
QFrame#cardActiveEmployees,
QFrame#cardAdmins {
    background-color: #FFFFFF;
    border: 1px solid #D8E3EF;
    border-radius: 10px;
}

QFrame#cardTotalEmployees QLabel,
QFrame#cardActiveEmployees QLabel,
QFrame#cardAdmins QLabel {
    background-color: transparent;
    border: none;
}

QLabel#lblTotalEmployeesTitle,
QLabel#lblActiveEmployeesTitle,
QLabel#lblAdminsTitle {
    color: #60758E;
    font-size: 9pt;
}

QLabel#lblTotalEmployeesValue,
QLabel#lblActiveEmployeesValue,
QLabel#lblAdminsValue {
    color: #174A7E;
    font-size: 23pt;
    font-weight: bold;
}

QLineEdit#editEmployeeSearch {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 9px 11px;
    selection-background-color: #2D83D5;
}

QLineEdit#editEmployeeSearch:focus {
    border: 1px solid #2D83D5;
}

QComboBox#comboEmployeeRole {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 8px 10px;
}

QComboBox#comboEmployeeRole:hover {
    border: 1px solid #2D83D5;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #24364B;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
    border: 1px solid #D8E3EF;
}

QPushButton {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton:disabled {
    background-color: #B9C7D5;
    color: #F4F6F8;
    border: 1px solid #B9C7D5;
}

QPushButton#btnSearchEmployees,
QPushButton#btnAddEmployee,
QPushButton#btnEditEmployee {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
}

QPushButton#btnSearchEmployees:hover,
QPushButton#btnAddEmployee:hover,
QPushButton#btnEditEmployee:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton#btnSearchEmployees:pressed,
QPushButton#btnAddEmployee:pressed,
QPushButton#btnEditEmployee:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton#btnResetEmployeeFilters,
QPushButton#btnViewEmployee,
QPushButton#btnRefreshEmployees {
    background-color: #E4EBF3;
    color: #294D70;
    border: 1px solid #D0DCE8;
}

QPushButton#btnResetEmployeeFilters:hover,
QPushButton#btnViewEmployee:hover,
QPushButton#btnRefreshEmployees:hover {
    background-color: #D5E3F1;
    color: #294D70;
    border: 1px solid #C2D5E8;
}

QPushButton#btnResetEmployeeFilters:pressed,
QPushButton#btnViewEmployee:pressed,
QPushButton#btnRefreshEmployees:pressed {
    background-color: #C6D8EA;
    color: #294D70;
    border: 1px solid #B5CADD;
}

QPushButton#btnResetPassword {
    background-color: #E74C3C;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton#btnResetPassword:hover {
    background-color: #C0392B;
}

QTableWidget#tableEmployees {
    background-color: #FFFFFF;
    alternate-background-color: #F6F9FC;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E4EAF1;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
}

QTableWidget#tableEmployees::item {
    padding: 7px;
}

QTableWidget#tableEmployees::item:selected {
    background-color: #DCEBFA;
    color: #183B63;
}

QHeaderView::section {
    background-color: #E8EFF7;
    color: #244B73;
    border: none;
    border-bottom: 1px solid #D2DFEC;
    padding: 9px 7px;
    font-weight: bold;
}

QScrollBar:vertical {
    background-color: #EDF1F5;
    width: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #B7C7D8;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8FA9C3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #EDF1F5;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #B7C7D8;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}</string>
