   <string notr="true">
QDialog#EmployeeLoginDialog { background-color: #F4F7FA; }
QFrame#headerFrame { background-color: #173B60; border-radius: 14px; }
QLabel#lblLogo { color: white; font-size: 25pt; font-weight: bold; }
QLabel#lblSystemName, QLabel#lblHeaderSubtitle { color: #D7E7F6; font-size: 9pt; }
QLabel#lblHeaderTitle { color: white; font-size: 15pt; font-weight: bold; }
QFrame#loginCard { background-color: white; border: 1px solid #DCE4EC; border-radius: 14px; }
QLabel#lblFormTitle { color: #173B60; font-size: 15pt; font-weight: bold; }
QLabel#lblFormSubtitle { color: #64748B; font-size: 9pt; }
QLabel#lblEmail, QLabel#lblPassword { color: #334155; font-size: 9pt; font-weight: bold; border: none; }
QLineEdit { background: white; color: #1E293B; border: 1px solid #CBD5E1; border-radius: 7px; padding: 10px 12px; min-height: 20px; }
QLineEdit:focus { border: 1px solid #245A91; }
QFrame#passwordFrame { border: 1px solid #CBD5E1; border-radius: 7px; }
QFrame#passwordFrame QLineEdit { border: none; border-radius: 0px; }
QPushButton#btnTogglePassword { background: white; color: #245A91; border: none; padding: 7px 10px; min-width: 64px; }
QPushButton#btnTogglePassword:hover { background: #F1F5F9; }
QPushButton#btnLogin { background: #245A91; color: white; border: none; border-radius: 7px; padding: 12px; font-size: 10pt; font-weight: bold; min-height: 22px; }
QPushButton#btnLogin:hover { background: #1B466F; }
QPushButton#btnBack { background: transparent; color: #245A91; border: none; text-align: left; padding: 4px 0px; }
QPushButton#btnBack:hover { color: #173B60; text-decoration: underline; }
QCheckBox#chkRememberEmail { color: #475569; spacing: 7px; }
QLabel#lblError { color: #B42318; font-size: 9pt; }
QLabel#lblFooter { color: #94A3B8; font-size: 8pt; }
