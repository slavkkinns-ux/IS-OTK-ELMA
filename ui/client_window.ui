   <string notr="true">
QMainWindow { background: #F1F3F6; }
QFrame#sidebarFrame { background: #183B63; }
QLabel { color: #24364B; }
QLabel#logoLabel { color: white; font-size: 25px; font-weight: bold; }
QLabel#sidebarSubtitle { color: #C5D5E7; font-size: 12px; }
QPushButton {
 background: transparent;
 color: #EAF1F8;
 border: none;
 border-radius: 7px;
 padding: 12px;
 text-align: left;
 font-size: 14px;
}
QPushButton:hover { background: #244D78; }
QPushButton:checked { background: #2D83D5; color: white; }
QFrame#contentFrame { background: #F1F3F6; }
QFrame#cardFrame, QFrame#statsCard {
 background: white;
 border: 1px solid #D8E3EF;
 border-radius: 10px;
}
QLabel#pageTitle { font-size: 24px; font-weight: bold; color: #183B63; }
QLabel#pageSubtitle { color: #60758E; font-size: 13px; }
QLabel#statValue { color: #183B63; font-size: 26px; font-weight: bold; }
QLabel#statCaption { color: #60758E; font-size: 13px; }
QLabel#sectionTitle { font-size: 16px; font-weight: bold; color: #183B63; }
QLineEdit, QComboBox {
 background: white;
 border: 1px solid #D8E3EF;
 border-radius: 6px;
 padding: 8px;
 min-height: 22px;
}
QTableWidget {
 background: white;
 border: 1px solid #D8E3EF;
 border-radius: 7px;
 gridline-color: #E8EDF3;
 selection-background-color: #DCEBFA;
 selection-color: #183B63;
}
QHeaderView::section {
 background: #EDF2F7;
 color: #183B63;
 padding: 9px;
 border: none;
 font-weight: bold;
}
QPushButton#btnPrimary {
 background: #2D83D5;
 color: white;
 text-align: center;
 padding: 10px 18px;
}
QPushButton#btnPrimary:hover { background: #246EBA; }
