           <widget class="QWidget" name="pageReports">
            <property name="styleSheet">
             <string notr="true">QWidget#pageReports {
    background-color: #F1F3F6;
    color: #24364B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel#lblReportsTitle {
    color: #183B63;
    font-size: 20pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#lblReportsSubtitle {
    color: #60758E;
    font-size: 10pt;
    background: transparent;
    border: none;
}

QFrame#reportsWorkspaceFrame {
    background: transparent;
    border: none;
}

QFrame#reportCreationFrame,
QFrame#reportPreviewFrame {
    background-color: #FFFFFF;
    border: 1px solid #D8E3EF;
    border-radius: 10px;
}

QLabel#lblReportCreationTitle,
QLabel#lblReportPreviewTitle {
    color: #183B63;
    font-size: 13pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QFrame#reportClientInfoFrame {
    background-color: #F7F9FB;
    border: 1px solid #E3EAF1;
    border-radius: 8px;
}

QLabel#lblReportClientTitle {
    color: #183B63;
    font-size: 10pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#lblReportClientName,
QLabel#lblReportClientContact {
    color: #60758E;
    background: transparent;
    border: none;
}

QLabel#lblReportOrder,
QLabel#lblReportResearchTitle {
    color: #40566E;
    background: transparent;
    border: none;
}

QComboBox#comboReportOrder {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #CBD7E4;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 22px;
}

QComboBox#comboReportOrder:focus {
    border: 1px solid #2D83D5;
}

QComboBox#comboReportOrder QAbstractItemView {
    background-color: #FFFFFF;
    color: #24364B;
    selection-background-color: #E7F0F8;
    selection-color: #183B63;
    border: 1px solid #D8E3EF;
}

QTableWidget#tableReportResearch,
QTableWidget#tableRecentReports {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FB;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E8EDF2;
    selection-background-color: #E4EEF7;
    selection-color: #183B63;
    outline: none;
}

QTableWidget#tableReportResearch::item,
QTableWidget#tableRecentReports::item {
    padding: 7px;
    border-bottom: 1px solid #EDF0F4;
}

QTableWidget#tableReportResearch::item:selected,
QTableWidget#tableRecentReports::item:selected {
    background-color: #E4EEF7;
    color: #183B63;
}

QHeaderView::section {
    background-color: #F3F6F9;
    color: #40566E;
    border: none;
    border-bottom: 1px solid #D8E3EF;
    padding: 9px 8px;
    font-weight: 600;
}

QWidget#reportPreviewContent {
    background-color: #F7F9FB;
    border: 1px solid #E3EAF1;
    border-radius: 8px;
}

QFrame#recentReportsFrame {
    background-color: #FFFFFF;
    border: 1px solid #D8E3EF;
    border-radius: 10px;
}

QLabel#lblRecentReportsTitle {
    color: #183B63;
    font-size: 13pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QPushButton {
    background-color: #FFFFFF;
    color: #183B63;
    border: 1px solid #CBD7E4;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #EDF3F8;
    border: 1px solid #AFC2D5;
}

QPushButton:pressed {
    background-color: #E1EAF2;
}

QPushButton#btnCreateReport {
    background-color: #183B63;
    color: #FFFFFF;
    border: 1px solid #183B63;
}

QPushButton#btnCreateReport:hover {
    background-color: #244D78;
    border: 1px solid #244D78;
}

QPushButton#btnCreateReport:pressed {
    background-color: #122F50;
}

QPushButton#btnOpenReport {
    background-color: #FFFFFF;
    color: #2D6FA8;
    border: 1px solid #B9CFE2;
}

QPushButton#btnOpenReport:hover {
    background-color: #EDF4FA;
}</string>
