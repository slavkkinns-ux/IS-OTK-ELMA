    border-radius: 10px;
}

QFrame#cardTotalOrders QLabel,
QFrame#cardOrdersInProgress QLabel,
QFrame#cardOrdersPending QLabel,
QFrame#cardOrdersCompleted QLabel {
    background-color: transparent;
    border: none;
}

QLabel#lblTotalOrdersTitle,
QLabel#lblOrdersInProgressTitle,
QLabel#lblOrdersPendingTitle,
QLabel#lblOrdersCompletedTitle {
    color: #60758E;
