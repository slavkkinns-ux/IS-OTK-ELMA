}

QLabel#lblTotalOrdersValue,
QLabel#lblOrdersInProgressValue,
QLabel#lblOrdersPendingValue,
QLabel#lblOrdersCompletedValue {
    color: #174A7E;
    font-size: 23pt;
    font-weight: bold;
}

QLineEdit#editOrderSearch {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 9px 11px;
    selection-background-color: #2D83D5;
}

QLineEdit#editOrderSearch:focus {
    border: 1px solid #2D83D5;
}

QComboBox#comboOrderStatus {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #D1DCE8;
    border-radius: 7px;
    padding: 8px 10px;
}

QComboBox#comboOrderStatus:hover {
    border: 1px solid #2D83D5;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #24364B;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
    border: 1px solid #D8E3EF;
}

QPushButton {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton:disabled {
    background-color: #B9C7D5;
    color: #F4F6F8;
    border: 1px solid #B9C7D5;
}

QPushButton#btnSearchOrders,
QPushButton#btnAddOrder,
QPushButton#btnEditOrder {
    background-color: #2D83D5;
    color: #FFFFFF;
    border: 1px solid #2D83D5;
}

QPushButton#btnSearchOrders:hover,
QPushButton#btnAddOrder:hover,
QPushButton#btnEditOrder:hover {
    background-color: #3B94E8;
    color: #FFFFFF;
    border: 1px solid #3B94E8;
}

QPushButton#btnSearchOrders:pressed,
QPushButton#btnAddOrder:pressed,
QPushButton#btnEditOrder:pressed {
    background-color: #1E68AE;
    color: #FFFFFF;
    border: 1px solid #1E68AE;
}

QPushButton#btnResetOrderFilters,
QPushButton#btnViewOrder,
QPushButton#btnRefreshOrder,
QPushButton#btnResetOrderFilters:hover,
QPushButton#btnViewOrder:hover,
QPushButton#btnRefreshOrder:hover {
    background-color: #E4EBF3;
    color: #294D70;
    border: 1px solid #D0DCE8;
}

QPushButton#btnResetOrderFilters:hover,
QPushButton#btnViewOrder:hover,
QPushButton#btnRefreshOrder:hover {
    background-color: #D5E3F1;
    color: #294D70;
    border: 1px solid #C2D5E8;
}

QPushButton#btnResetOrderFilters:pressed,
QPushButton#btnViewOrder:pressed,
QPushButton#btnRefreshOrder:pressed {
    background-color: #C6D8EA;
    color: #294D70;
    border: 1px solid #B5CADD;
}

QTableWidget#tableOrders {
    background-color: #FFFFFF;
    alternate-background-color: #F6F9FC;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E4EAF1;
    selection-background-color: #DCEBFA;
    selection-color: #183B63;
}

QTableWidget#tableOrders::item {
    padding: 7px;
}

QTableWidget#tableOrders::item:selected {
    background-color: #DCEBFA;
    color: #183B63;
}

QHeaderView::section {
    background-color: #E8EFF7;
    color: #244B73;
    border: none;
    border-bottom: 1px solid #D2DFEC;
    padding: 9px 7px;
    font-weight: bold;
}

QScrollBar:vertical {
    background-color: #EDF1F5;
    width: 10px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #B7C7D8;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8FA9C3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #EDF1F5;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #B7C7D8;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}</string>
