            <property name="styleSheet">
             <string notr="true">QWidget#pageResearch {
    background-color: #F1F3F6;
    color: #24364B;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel#lblResearchTitle {
    color: #183B63;
    font-size: 20pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#lblResearchSubtitle {
    color: #60758E;
    font-size: 10pt;
    background: transparent;
    border: none;
}

QFrame#researchWorkspaceFrame {
    background: transparent;
    border: none;
}

QFrame#researchQueueFrame,
QFrame#researchDetailFrame {
    background-color: #FFFFFF;
    border: 1px solid #D8E3EF;
    border-radius: 10px;
}

QLabel#lblResearchQueueTitle,
QLabel#lblResearchDetailTitle {
    color: #183B63;
    font-size: 13pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QFrame#researchFilterFrame {
    background-color: #F7F9FB;
    border: 1px solid #E3EAF1;
    border-radius: 8px;
}

QLineEdit#editResearchSearch {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #CBD7E4;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 20px;
}

QLineEdit#editResearchSearch:focus {
    border: 1px solid #2D83D5;
}

QComboBox#comboResearchFilter {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #CBD7E4;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 22px;
}

QComboBox#comboResearchFilter:focus {
    border: 1px solid #2D83D5;
}

QComboBox#comboResearchFilter QAbstractItemView {
    background-color: #FFFFFF;
    color: #24364B;
    selection-background-color: #E7F0F8;
    selection-color: #183B63;
    border: 1px solid #D8E3EF;
}

QTableWidget#tableResearchQueue {
    background-color: #FFFFFF;
    alternate-background-color: #F7F9FB;
    color: #24364B;
    border: 1px solid #D8E3EF;
    border-radius: 8px;
    gridline-color: #E8EDF2;
    selection-background-color: #E4EEF7;
    selection-color: #183B63;
    outline: none;
}

QTableWidget#tableResearchQueue::item {
    padding: 7px;
    border-bottom: 1px solid #EDF0F4;
}

QTableWidget#tableResearchQueue::item:selected {
    background-color: #E4EEF7;
    color: #183B63;
}

QHeaderView::section {
    background-color: #F3F6F9;
    color: #40566E;
    border: none;
    border-bottom: 1px solid #D8E3EF;
    padding: 9px 8px;
    font-weight: 600;
}

QFrame#researchInfoFrame {
    background-color: #F7F9FB;
    border: 1px solid #E3EAF1;
    border-radius: 8px;
}

QLabel#lblResearchOrder,
QLabel#lblResearchVessel,
QLabel#lblResearchClient,
QLabel#lblResearchService {
    color: #60758E;
    background: transparent;
    border: none;
}

QLabel#lblResearchOrderValue,
QLabel#lblResearchVesselValue,
QLabel#lblResearchClientValue,
QLabel#lblResearchServiceValue {
    color: #183B63;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLabel#lblResearchResultTitle {
    color: #183B63;
    font-size: 11pt;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#lblResultValue,
QLabel#lblConclusion,
QLabel#lblResultDate {
    color: #40566E;
    background: transparent;
    border: none;
}

QLineEdit#editResultValue,
QTextEdit#editConclusion,
QDateEdit#dateResultDate,
QComboBox#comboResearchEmployee {
    background-color: #FFFFFF;
    color: #24364B;
    border: 1px solid #CBD7E4;
    border-radius: 6px;
    padding: 7px 10px;
}

QLineEdit#editResultValue:focus,
QTextEdit#editConclusion:focus,
QDateEdit#dateResultDate:focus,
QComboBox#comboResearchEmployee:focus {
    border: 1px solid #2D83D5;
}

QPushButton {
    background-color: #FFFFFF;
    color: #183B63;
    border: 1px solid #CBD7E4;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #EDF3F8;
    border: 1px solid #AFC2D5;
}

QPushButton:pressed {
    background-color: #E1EAF2;
}

QPushButton:disabled {
    background-color: #F1F3F6;
    color: #9AA9B8;
    border: 1px solid #D8E3EF;
}

QPushButton#btnSaveResearchResult {
    background-color: #183B63;
    color: #FFFFFF;
    border: 1px solid #183B63;
}

QPushButton#btnSaveResearchResult:hover {
    background-color: #244D78;
    border: 1px solid #244D78;
}

QPushButton#btnSaveResearchResult:pressed {
    background-color: #122F50;
}

QPushButton#btnClearResearchResult,
QPushButton#btnViewResearchResult {
    background-color: #FFFFFF;
    color: #2D6FA8;
    border: 1px solid #B9CFE2;
}

QPushButton#btnClearResearchResult:hover,
QPushButton#btnViewResearchResult:hover {
    background-color: #EDF4FA;
}

QScrollBar:vertical {
    background-color: #F1F3F6;
    width: 8px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #C5D1DD;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: #AABACA;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F1F3F6;
    height: 8px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #C5D1DD;
    border-radius: 4px;
    min-width: 25px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}</string>
